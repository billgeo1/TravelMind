
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# 高德 MCP 服务启动命令(可选)。留空即使用默认值:
#   uvx --with "pydantic<2.14" amap-mcp-server
# 原因:amap-mcp-server 依赖 mcp==1.8.1,与 pydantic>=2.14 不兼容,必须锁定 pydantic 版本。
# 若已在本机虚拟环境安装好该服务,可改成该环境的启动命令,例如:
#   C:\path\to\venv\Scripts\amap-mcp-server.exe
AMAP_MCP_COMMAND=

# ==================== 高德 MCP 调用的稳定性参数(可选调优) ====================
# 背景:当前版本的 amap-mcp-server 里,公交/地铁工具
# (maps_direction_transit_integrated_by_coordinates / _by_address)会返回单引号
# 的非法 JSON,MCP 客户端解析失败后无限等待,把"行程体检"整条链路拖到超时。

# 单次高德 MCP 调用的超时(秒)。超时按失败处理,不再无限等待。
AMAP_MCP_TIMEOUT_SECONDS=20

# 公交/地铁接口连续失败多少次后判定为不可用(默认 2)
AMAP_TRANSIT_FAILURE_THRESHOLD=2

# 判定不可用后的冷却时间(秒),期间不再尝试该接口
AMAP_TRANSIT_COOLDOWN_SECONDS=900

# 公交接口不可用时,是否改用驾车耗时做近似估算(报告里会标注为 amap_proxy 近似值)
AMAP_TRANSIT_FALLBACK_DRIVING=true

# 搜索 POI 时,为前 N 条结果补齐经纬度的详情查询数量(默认 5)。
# maps_text_search 只返回 id/name/address,不含坐标,需逐条调用 maps_search_detail 补齐。
TRAVELMIND_POI_DETAIL_LIMIT=5

# ==================== TravelMind 增量功能配置 ====================
# 演示模式:开启后,缺失外部服务时使用带 "演示数据/mock" 标识的固定数据跑通全流程
# 生产环境请保持 false。可用值: true / false
TRAVELMIND_DEMO_MODE=false

# 攻略截图上传的最大体积(MiB),服务端为准(默认 10)
TRAVELMIND_MAX_IMAGE_MB=10

# 是否允许在智能修复时调用 LLM 生成候选排序(默认 false,确定性规则已足够)
TRAVELMIND_ENABLE_LLM_REPAIR=false

# 视觉模型配置(用于攻略截图识别)。三者都为空时,截图导入接口返回 VISION_NOT_CONFIGURED
# 兼容 OpenAI Chat Completions 的多模态接口(如 gpt-4o / qwen-vl 等)
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1

# ==================== 截图识别的性能与超时(可选调优) ====================
# 背景:高德 MCP 每次调用都会重新拉起一个 `uvx amap-mcp-server` 子进程,
# 本机实测单次 POI 查询约 15s。截图里的地点越多,串行查询就越久,
# 不并发就会让前端等到超时。以下参数用于控制这条链路的耗时。

# 送给视觉模型前,图片长边缩放上限(像素;0 = 不缩放)。手机截图 3~5MB,缩放后通常只剩几百 KB。
TRAVELMIND_VISION_MAX_DIMENSION=1600

# 视觉模型单次调用的读超时(秒)
TRAVELMIND_VISION_TIMEOUT_SECONDS=90

# 截图导入时 POI 匹配的并发度(1 = 串行)
TRAVELMIND_POI_CONCURRENCY=4

# 截图导入时,每个候选额外补齐坐标的详情条目数(仅影响截图导入,不影响行程生成)
TRAVELMIND_IMPORT_POI_DETAIL_LIMIT=2

# 截图导入 POI 匹配阶段的总时间预算(秒);超出后返回已完成的部分结果并给出 warning
TRAVELMIND_IMPORT_POI_BUDGET_SECONDS=90

# ==================== 行程体检的事实核验性能(可选调优) ====================
# 背景:体检要逐景点核对营业时间、逐对相邻景点核对交通耗时、逐天核对天气,
# 而高德 MCP 每次调用都会重建子进程(冷启动 13-15s)。实现上会先把"去重后的
# 最小事实集合"并发取回,并给出总时间预算;超出预算时降级为 partial 报告
# (未取回的项如实标为「未核实」),而不是把请求挂到超时。

# 事实核验并发度(建议 4;过高会触发高德每秒调用限额)
TRAVELMIND_HEALTH_CONCURRENCY=4

# 事实核验总时间预算(秒)。超出行程较大的行程会返回 partial 报告
TRAVELMIND_HEALTH_BUDGET_SECONDS=150
